!.env.example

# Test artifacts — not needed in production image
tests
coverage
*.test.ts
*.spec.ts

# Development tooling
*.log
npm-debug.log*
.DS_Store

# Git
.git
.gitignore

# Editor
.vscode
.idea

# Docker itself
Dockerfile
docker-compose*.yml
